          "http": {
            "method": "GET",
            "url": "https://api.ultravox.ai/api/voices/:voice_id/preview",
            "params": [
              {
                "name": "voice_id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "X-API-Key",
              "value": "{{X-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "Provides an audio sample for a voice, or the error caused by using it."
        }
      ]
    }
  ],
  "bundled": true
}