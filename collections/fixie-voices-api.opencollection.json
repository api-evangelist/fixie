            },
            "auth": {
              "type": "apikey",
              "key": "X-API-Key",
              "value": "{{X-API-Key}}",
              "placement": "header"
            }
          }
        },
        {
          "info": {
            "name": "voices_destroy",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.ultravox.ai/api/voices/:voice_id",
            "params": [
              {
