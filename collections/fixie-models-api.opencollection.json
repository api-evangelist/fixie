{
  "opencollection": "1.0.0",
  "info": {
    "name": "Ultravox accounts models API",
    "version": "0.1.0"
  },
  "items": [
    {
      "info": {
        "name": "models",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "models_list",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.ultravox.ai/api/models",
            "params": [
              {
                "name": "cursor",
                "value": "",
                "type": "query",
                "description": "The pagination cursor value."
              },
              {
                "name": "pageSize",
                "value": "",
                "type": "query",
                "description": "Number of results to return per page."
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "X-API-Key",
              "value": "{{X-API-Key}}",
              "placement": "header"
            }
          }
        }
      ]
    }
  ],
  "bundled": true
}